{
  "name": "spacekid-labs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsx scripts/fetch-databend-release.ts && vite build && tsx scripts/prerender.ts && tsx scripts/generate-seo-files.ts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js server.cjs",
    "preview:cf": "npm run build:site && wrangler dev",
    "deploy": "npm run build:site && wrangler deploy",
    "lint": "tsc --noEmit && tsc -p worker",
    "build:site": "tsx scripts/fetch-databend-release.ts && vite build && tsx scripts/prerender.ts && tsx scripts/generate-seo-files.ts",
    "favicons": "tsx scripts/fetch-favicons.ts"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@cloudflare/workers-oauth-provider": "^1.4.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261128.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "wrangler": "^4.169.0"
  }
}
