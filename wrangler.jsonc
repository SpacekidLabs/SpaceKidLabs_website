// Cloudflare Workers config for spacekidlabs.com. See docs/HOSTING.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spacekidlabs",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",

  // The pre-rendered site (npm run build:site). Cloudflare serves these files directly, free and without
  // running the Worker: /download serves download.html, and unknown URLs get 404.html with a 404 status.
  // Cache headers are in public/_headers.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker runs first only for the API, the MCP connector and its OAuth sign-in; everything else is static.
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/authorize",
      "/token",
      "/register",
      "/.well-known/oauth-authorization-server",
      "/.well-known/oauth-authorization-server/*",
      "/.well-known/oauth-protected-resource",
      "/.well-known/oauth-protected-resource/*"
    ]
  },

  // Contact form (POST /api/contact): emails each message through Cloudflare Email Routing.
  // The recipient is the CONTACT_TO secret (set in the Cloudflare dashboard, not in this repo) and must be a
  // verified destination address in Email Routing for spacekidlabs.com.
  "send_email": [{ "name": "CONTACT_EMAIL" }],
  "vars": {
    "CONTACT_FROM": "contact-form@spacekidlabs.com",
    // The /dev dashboard commits here. Its secrets (DEV_PASSWORD, GITHUB_TOKEN) are set in the Cloudflare
    // dashboard, never in this file. See docs/HOSTING.md.
    "GITHUB_REPO": "SpacekidLabs/SpaceKidLabs_website",
    // Traffic numbers on /dev (worker/analytics.ts). These are identifiers, not credentials: reading anything
    // needs the CF_API_TOKEN secret (analytics read-only), which is set in Cloudflare, never here.
    "CF_ZONE_ID": "4b13163242261480a3f6acfdc865f248",
    "CF_ACCOUNT_ID": "a33a51651bcfc4f9dbad002c944bb8e7"
  },

  // MCP connector sign-ins (worker/oauth.ts): registered apps and grants, tokens stored only as hashes.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "8adf736d49ab448199a025f87afa075e" }],

  // Event counts (worker/events.ts): plays, downloads, labs started. Workers Analytics Engine, free plan.
  // Each point holds only the event name and which thing; no IP, cookie or user agent.
  // The private idea inbox on /dev (worker/ideas.ts). No database_id: `wrangler deploy` creates the database on the
  // first deploy and the Worker creates its tables on first use.
  "d1_databases": [{ "binding": "IDEAS_DB", "database_name": "spacekidlabs-ideas" }],

  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "spacekidlabs_events" }],

  "routes": [{ "pattern": "spacekidlabs.com", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
